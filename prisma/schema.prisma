// Esquema Prisma — Vincle Apps
//
// Estado tras DEV-004: a los maestros de referencia (DEV-002) y al núcleo
// transaccional del Gestor de Ofertas (DEV-003) se añaden la identidad local
// provisional (`User`, `Session`), la trazabilidad funcional de la oferta
// (`OfferVersion`, `OfferComment`, `OfferAttachment`), el archivo lógico con
// actor y las notificaciones internas configurables (`Notification`,
// `NotificationRule` y sus condiciones y acciones).
//
// Siguen siendo conceptuales, y deliberadamente fuera de este esquema:
// `ImportBatch`, `ImportIssue` y cualquier entidad de ESM, FACT, tarifas o
// implantaciones. Ver docs/architecture/DATA_MODEL.md para el modelo
// conceptual completo y docs/decisions/DECISIONS.md para las decisiones que
// enmarcan este alcance.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Maestro de prioridades de oferta (Alta, Media, Baja).
model Priority {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  offers Offer[]

  @@map("priorities")
}

/// Maestro de orígenes de oferta (Comercial, PM, CS).
model Origin {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  offers Offer[]

  @@map("origins")
}

/// Maestro de tipos de oferta (Bolsa de horas, Cambio de alcance, Proyecto).
model OfferType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  offers Offer[]

  @@map("offer_types")
}

/// Maestro de estados de oferta. El flujo y las transiciones entre estados
/// son una decisión pendiente (ver docs/decisions/DECISIONS.md, DEC-051) y no
/// se implementan en esta entrega.
model OfferStatus {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  offers                     Offer[]
  statusHistoryAsPrevious    OfferStatusHistory[]        @relation("OfferStatusHistoryPrevious")
  statusHistoryAsNew         OfferStatusHistory[]        @relation("OfferStatusHistoryNew")
  notificationRuleConditions NotificationRuleCondition[] @relation("NotificationRuleConditionStatus")

  @@map("offer_statuses")
}

/// Maestro de segmentaciones de oferta.
model Segmentation {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  offers Offer[]

  @@map("segmentations")
}

/// Maestro de perfiles profesionales usados en las jornadas de una oferta.
/// Los códigos son funcionales y conocidos (ver docs/offers/BUSINESS_RULES.md)
/// y no deben modificarse sin una decisión explícita.
model ProfessionalProfile {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  offerProfileDays OfferProfileDays[]

  @@map("professional_profiles")
}

/// @deprecated (DEV-005): `Idioma` se retira de toda la experiencia funcional
/// del Gestor de Ofertas (formularios, ficha, Administración, filtros,
/// exportación e instantáneas nuevas de versión). Esta tabla y la columna
/// `Offer.languageId` se conservan **sin uso funcional** por compatibilidad
/// técnica con datos e instantáneas ya existentes: eliminarlas ahora sería una
/// migración destructiva innecesaria. Quedan pendientes de limpieza física
/// futura una vez confirmada la ausencia de datos relevantes. Ver
/// docs/decisions/DECISIONS.md.
model Language {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  offers Offer[]

  @@map("languages")
}

/// Maestro de motivos de cancelación de oferta. Todavía sin valores aprobados
/// (ver docs/shared/MASTER_DATA.md): la tabla existe vacía en esta entrega.
model CancellationReason {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  offers Offer[]

  @@map("cancellation_reasons")
}

// ---------------------------------------------------------------------------
// Núcleo transaccional del Gestor de Ofertas (DEV-003)
// ---------------------------------------------------------------------------

/// Maestro de clientes.
///
/// `nameNormalized` es una columna derivada (minúsculas, sin espacios
/// exteriores y con espacios interiores colapsados) con restricción única:
/// es la forma compatible con PostgreSQL de impedir duplicados exactos de
/// nombre sin depender de una extensión ni de un índice funcional que Prisma
/// no modela. La aplicación la calcula siempre a partir de `name`.
/// Ver docs/shared/MASTER_DATA.md.
/// `code` es el código de cliente introducido por el usuario (DEV-004). Se
/// conserva con la capitalización exacta que se escribe y solo se recortan
/// los espacios exteriores. Es **funcionalmente obligatorio** en el alta y en
/// cualquier guardado de edición, pero la columna es nullable: los clientes
/// creados en DEV-003 no tienen código y no se les inventa ninguno. La
/// restricción única de PostgreSQL ignora los `NULL`, de modo que conviven
/// varios clientes «Código pendiente» sin colisionar.
model Client {
  id             String   @id @default(cuid())
  code           String?  @unique
  name           String
  nameNormalized String   @unique @map("name_normalized")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  offers                     Offer[]
  notificationRuleConditions NotificationRuleCondition[] @relation("NotificationRuleConditionClient")

  @@index([isActive, name])
  @@map("clients")
}

/// Maestro común de personas (DEC-013): comercial y Project Manager no son
/// entidades separadas, sino dos habilitaciones sobre el mismo registro.
/// Una persona puede tener una, las dos o ninguna.
model Person {
  id                  String   @id @default(cuid())
  name                String
  canBeCommercial     Boolean  @default(false) @map("can_be_commercial")
  canBeProjectManager Boolean  @default(false) @map("can_be_project_manager")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  commercialOffers           Offer[]                     @relation("OfferCommercial")
  projectManagerOffers       Offer[]                     @relation("OfferProjectManager")
  user                       User?
  notificationRuleConditions NotificationRuleCondition[] @relation("NotificationRuleConditionPerson")
  notificationRuleActions    NotificationRuleAction[]    @relation("NotificationRuleActionPerson")

  @@index([isActive, name])
  @@map("people")
}

/// Oferta. Entidad central del módulo.
///
/// `number` es único e inmutable: se asigna una sola vez, dentro de la
/// transacción del primer guardado, a partir de `SystemCounter` (DEC-010,
/// DEC-011). El total de jornadas por perfil NO se almacena aquí: se deriva
/// siempre de `OfferProfileDays` (DEC-014).
model Offer {
  id     String @id @default(cuid())
  number String @unique

  // Identificación y relaciones obligatorias
  clientId         String   @map("client_id")
  priorityId       String   @map("priority_id")
  commercialId     String   @map("commercial_id")
  offerDate        DateTime @map("offer_date") @db.Date
  originId         String   @map("origin_id")
  projectManagerId String   @map("project_manager_id")
  description      String
  offerTypeId      String   @map("offer_type_id")
  totalAmount      Decimal  @map("total_amount") @db.Decimal(14, 2)
  statusId         String   @map("status_id")
  requesterName    String   @map("requester_name")

  // Campos opcionales
  implantationText                String?   @map("implantation_text")
  estimatedCommercialDeliveryDate DateTime? @map("estimated_commercial_delivery_date") @db.Date
  estimatedClientDeliveryDate     DateTime? @map("estimated_client_delivery_date") @db.Date
  commercialDays                  Decimal?  @map("commercial_days") @db.Decimal(8, 2)
  estimatedPortfolioDate          DateTime? @map("estimated_portfolio_date") @db.Date
  segmentationId                  String?   @map("segmentation_id")
  notes                           String?
  /// @deprecated (DEV-005): sin uso funcional. Ver el comentario de `Language`.
  languageId                      String?   @map("language_id")
  navisionOrder                   String?   @map("navision_order")
  cancellationReasonId            String?   @map("cancellation_reason_id")

  // Control de registro. `deletedAt` es el archivo lógico visible de DEV-004
  // (DEC-016): una oferta archivada desaparece del listado ordinario pero
  // nunca se borra físicamente, y se puede recuperar con el mismo número.
  // `Anulado` es un estado de negocio distinto y no implica archivo.
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  archivedById String?   @map("archived_by_id")
  restoredAt   DateTime? @map("restored_at")
  restoredById String?   @map("restored_by_id")

  /// Creador autenticado. Nullable: las ofertas anteriores al login no lo
  /// tienen y no se les inventa uno (solo un ADMIN puede verlas si no le
  /// corresponden por comercial o PM).
  createdById String? @map("created_by_id")

  client             Client              @relation(fields: [clientId], references: [id])
  priority           Priority            @relation(fields: [priorityId], references: [id])
  commercial         Person              @relation("OfferCommercial", fields: [commercialId], references: [id])
  projectManager     Person              @relation("OfferProjectManager", fields: [projectManagerId], references: [id])
  origin             Origin              @relation(fields: [originId], references: [id])
  offerType          OfferType           @relation(fields: [offerTypeId], references: [id])
  status             OfferStatus         @relation(fields: [statusId], references: [id])
  segmentation       Segmentation?       @relation(fields: [segmentationId], references: [id])
  language           Language?           @relation(fields: [languageId], references: [id])
  cancellationReason CancellationReason? @relation(fields: [cancellationReasonId], references: [id])

  createdBy  User? @relation("OfferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  archivedBy User? @relation("OfferArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  restoredBy User? @relation("OfferRestoredBy", fields: [restoredById], references: [id], onDelete: SetNull)

  profileDays   OfferProfileDays[]
  statusHistory OfferStatusHistory[]
  versions      OfferVersion[]
  comments      OfferComment[]
  attachments   OfferAttachment[]
  notifications Notification[]

  @@index([deletedAt, offerDate])
  @@index([createdById])
  @@index([statusId, deletedAt])
  @@index([clientId])
  @@index([commercialId])
  @@index([projectManagerId])
  @@index([statusId])
  @@index([offerTypeId])
  @@index([originId])
  @@index([priorityId])
  @@index([segmentationId])
  @@index([languageId])
  @@index([cancellationReasonId])
  @@map("offers")
}

/// Detalle de jornadas de una oferta por perfil profesional.
/// Una oferta puede no tener ninguna fila. No se crean filas para valores
/// vacíos ni para cero: el total se deriva sumando las filas existentes.
model OfferProfileDays {
  id                    String  @id @default(cuid())
  offerId               String  @map("offer_id")
  professionalProfileId String  @map("professional_profile_id")
  days                  Decimal @db.Decimal(8, 2)

  offer               Offer               @relation(fields: [offerId], references: [id])
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id])

  @@unique([offerId, professionalProfileId])
  @@index([professionalProfileId])
  @@map("offer_profile_days")
}

/// Histórico de cambios de estado de una oferta.
///
/// El alta crea el primer evento con `previousStatusId` a `null`. Una
/// modificación solo añade un evento si el estado cambia realmente.
/// `actorId` permanece `null` mientras no exista autenticación (DEC-019):
/// no se inventa ningún usuario técnico.
model OfferStatusHistory {
  id               String   @id @default(cuid())
  offerId          String   @map("offer_id")
  previousStatusId String?  @map("previous_status_id")
  newStatusId      String   @map("new_status_id")
  changedAt        DateTime @default(now()) @map("changed_at")
  actorId          String?  @map("actor_id")

  offer          Offer        @relation(fields: [offerId], references: [id])
  previousStatus OfferStatus? @relation("OfferStatusHistoryPrevious", fields: [previousStatusId], references: [id])
  newStatus      OfferStatus  @relation("OfferStatusHistoryNew", fields: [newStatusId], references: [id])
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([offerId, changedAt])
  @@index([actorId])
  @@index([previousStatusId])
  @@index([newStatusId])
  @@map("offer_status_history")
}

/// Contadores técnicos del sistema. El único contador de esta entrega es
/// `offer_number`, que alimenta la numeración global de ofertas (DEC-010).
///
/// El incremento se realiza con un `UPDATE ... RETURNING` atómico dentro de
/// la transacción del alta, de modo que dos altas concurrentes nunca obtienen
/// el mismo valor. No existe interfaz de ajuste manual: DEC-012 exige un área
/// protegida y todavía no hay autenticación.
model SystemCounter {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_counters")
}

/// Auditoría mínima de altas, modificaciones y activaciones/desactivaciones.
///
/// `actorId` referencia al usuario autenticado desde DEV-004. Sigue siendo
/// nullable para conservar íntegros los registros anteriores al login, que se
/// muestran como «Usuario no disponible (registro anterior al login)».
/// `changes` guarda una representación estructurada de los campos
/// modificados; nunca credenciales, tokens, contenido binario ni rutas
/// físicas. Ver docs/architecture/SECURITY.md.
model AuditLog {
  id         String   @id @default(cuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  changes    Json?
  actorId    String?  @map("actor_id")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Identidad local provisional (DEV-004)
// ---------------------------------------------------------------------------

/// Rol de acceso a la plataforma (DEC-055). Solo dos valores en esta fase.
enum UserRole {
  ADMIN
  USER
}

/// Cuenta de acceso local provisional.
///
/// Sustituye a la ausencia total de autenticación de DEV-003 (`DEC-019`), pero
/// **no** es el mecanismo corporativo definitivo: `DEC-056` (SSO o proveedor
/// final) sigue pendiente.
///
/// `username` se normaliza a minúsculas sin espacios exteriores y esa forma
/// normalizada es la que lleva la restricción única. `passwordHash` guarda
/// únicamente una cadena `scrypt$N$r$p$sal$hash`: jamás una contraseña en
/// claro, y nunca se envía al cliente.
model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  passwordHash       String   @map("password_hash")
  role               UserRole @default(USER)
  isActive           Boolean  @default(true) @map("is_active")
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  personId           String   @unique @map("person_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  person Person @relation(fields: [personId], references: [id])

  sessions            Session[]
  auditLogs           AuditLog[]
  statusHistory       OfferStatusHistory[]
  createdOffers       Offer[]              @relation("OfferCreatedBy")
  archivedOffers      Offer[]              @relation("OfferArchivedBy")
  restoredOffers      Offer[]              @relation("OfferRestoredBy")
  offerVersions       OfferVersion[]
  comments            OfferComment[]
  uploadedAttachments OfferAttachment[]    @relation("OfferAttachmentUploadedBy")
  removedAttachments  OfferAttachment[]    @relation("OfferAttachmentRemovedBy")
  notifications       Notification[]       @relation("NotificationRecipient")
  causedNotifications Notification[]       @relation("NotificationActor")

  @@index([isActive])
  @@map("users")
}

/// Sesión de acceso.
///
/// La base de datos guarda **solo el hash SHA-256 del token** (`tokenHash`);
/// el token aleatorio de 256 bits vive únicamente en la cookie `HttpOnly`.
/// Cerrar sesión elimina la fila, de modo que el token deja de ser válido de
/// inmediato aunque la cookie sobreviva en el navegador.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Trazabilidad funcional de la oferta (DEV-004)
// ---------------------------------------------------------------------------

/// Versión funcional inmutable de una oferta.
///
/// La auditoría técnica registra *qué campo cambió*; esta tabla conserva la
/// *instantánea completa* de la oferta en un momento dado, con los códigos y
/// nombres presentables de cada maestro además de sus identificadores, para
/// que una versión antigua siga siendo legible aunque después se renombre un
/// catálogo. `version` empieza en 1 y es única dentro de la oferta: la
/// restricción única de PostgreSQL impide que dos guardados simultáneos
/// creen el mismo número. Nunca se edita ni se elimina una versión.
model OfferVersion {
  id        String   @id @default(cuid())
  offerId   String   @map("offer_id")
  version   Int
  createdAt DateTime @default(now()) @map("created_at")
  authorId  String?  @map("author_id")
  snapshot  Json

  offer  Offer @relation(fields: [offerId], references: [id])
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([offerId, version])
  @@index([offerId, createdAt])
  @@map("offer_versions")
}

/// Comentario interno de una oferta.
///
/// Es append-only desde la interfaz: no se edita ni se borra en esta fase. El
/// autor y la fecha proceden siempre de la sesión, nunca del formulario.
model OfferComment {
  id        String   @id @default(cuid())
  offerId   String   @map("offer_id")
  authorId  String?  @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  offer  Offer @relation(fields: [offerId], references: [id])
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([offerId, createdAt])
  @@index([authorId])
  @@map("offer_comments")
}

/// Metadatos de un adjunto de oferta.
///
/// `storageKey` es una clave **relativa** a la raíz configurada por
/// `OFFER_ATTACHMENTS_DIR`, nunca una ruta absoluta, y su nombre físico es un
/// identificador aleatorio: el nombre original del usuario solo se conserva
/// como metadato para mostrarlo y para la cabecera de descarga. El binario
/// vive fuera de `public/` y fuera de Git, y solo se sirve por una ruta
/// autenticada y autorizada.
///
/// La retirada es lógica (`removedAt`): el adjunto deja de poder descargarse
/// y queda trazado, pero no se purga el binario desde la interfaz.
model OfferAttachment {
  id           String    @id @default(cuid())
  offerId      String    @map("offer_id")
  originalName String    @map("original_name")
  storageKey   String    @unique @map("storage_key")
  contentType  String    @map("content_type")
  sizeBytes    Int       @map("size_bytes")
  uploadedById String?   @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  removedAt    DateTime? @map("removed_at")
  removedById  String?   @map("removed_by_id")

  offer      Offer @relation(fields: [offerId], references: [id])
  uploadedBy User? @relation("OfferAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  removedBy  User? @relation("OfferAttachmentRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)

  @@index([offerId, createdAt])
  @@index([removedAt])
  @@map("offer_attachments")
}

// ---------------------------------------------------------------------------
// Notificaciones internas (DEV-004, DEC-053)
// ---------------------------------------------------------------------------

/// Disparadores admitidos. Lista cerrada, deliberadamente corta: esta fase no
/// construye un motor genérico de workflow para otros módulos.
enum NotificationTrigger {
  OFFER_CREATED
  OFFER_STATUS_CHANGED
  OFFER_COMMENT_ADDED
  OFFER_ATTACHMENT_ADDED
  OFFER_PENDING_PM_REVIEW
  OFFER_PENDING_SALES_REVIEW
}

/// Canal de entrega de una regla.
///
/// `INTERNAL_AND_EMAIL` conserva la *intención* elegida por Administración,
/// pero en esta entrega el email no se configura ni se envía: solo se genera
/// la notificación interna. No se conecta ningún proveedor y no se registra
/// ningún envío, ni correcto ni fallido.
enum NotificationChannel {
  INTERNAL
  INTERNAL_AND_EMAIL
}

/// Campo evaluable por una condición de regla.
enum NotificationConditionField {
  STATUS
  PROJECT_MANAGER
  COMMERCIAL
  CREATOR
  CLIENT
  ARCHIVED
}

/// Operadores admitidos: cerrados y sencillos, sin expresiones libres.
enum NotificationConditionOperator {
  IS
  IS_NOT
}

/// Bloque al que pertenece una condición.
enum NotificationConditionGroup {
  ALL
  ANY
}

/// Tipo de destinatario de una acción de regla.
enum NotificationRecipientKind {
  PROJECT_MANAGER
  COMMERCIAL
  CREATOR
  ALL_ADMINS
  SPECIFIC_PERSON
}

/// Regla configurable de notificación, al estilo de un disparador.
model NotificationRule {
  id          String              @id @default(cuid())
  key         String?             @unique
  name        String
  description String?
  isActive    Boolean             @default(true) @map("is_active")
  trigger     NotificationTrigger
  channel     NotificationChannel @default(INTERNAL)
  sortOrder   Int                 @default(0) @map("sort_order")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  conditions    NotificationRuleCondition[]
  actions       NotificationRuleAction[]
  notifications Notification[]

  @@index([trigger, isActive])
  @@map("notification_rules")
}

/// Condición de una regla. El valor se guarda en la columna tipada que
/// corresponde al campo, para que PostgreSQL garantice la integridad
/// referencial en lugar de un texto libre.
model NotificationRuleCondition {
  id           String                        @id @default(cuid())
  ruleId       String                        @map("rule_id")
  group        NotificationConditionGroup
  field        NotificationConditionField
  operator     NotificationConditionOperator
  statusId     String?                       @map("status_id")
  personId     String?                       @map("person_id")
  clientId     String?                       @map("client_id")
  booleanValue Boolean?                      @map("boolean_value")

  rule   NotificationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  status OfferStatus?     @relation("NotificationRuleConditionStatus", fields: [statusId], references: [id])
  person Person?          @relation("NotificationRuleConditionPerson", fields: [personId], references: [id])
  client Client?          @relation("NotificationRuleConditionClient", fields: [clientId], references: [id])

  @@index([ruleId])
  @@index([statusId])
  @@index([personId])
  @@index([clientId])
  @@map("notification_rule_conditions")
}

/// Acción de destinatario de una regla. No admite direcciones externas ni
/// plantillas libres: solo los destinatarios derivados de la propia oferta o
/// una persona concreta con usuario activo.
model NotificationRuleAction {
  id       String                    @id @default(cuid())
  ruleId   String                    @map("rule_id")
  kind     NotificationRecipientKind
  personId String?                   @map("person_id")

  rule   NotificationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  person Person?          @relation("NotificationRuleActionPerson", fields: [personId], references: [id])

  @@index([ruleId])
  @@index([personId])
  @@map("notification_rule_actions")
}

/// Notificación interna entregada a un usuario concreto.
///
/// `dedupeKey` es la clave de idempotencia del evento: si dos reglas producen
/// exactamente la misma notificación dentro del mismo evento, la restricción
/// única impide duplicarla.
model Notification {
  id        String              @id @default(cuid())
  userId    String              @map("user_id")
  offerId   String?             @map("offer_id")
  ruleId    String?             @map("rule_id")
  trigger   NotificationTrigger
  channel   NotificationChannel @default(INTERNAL)
  title     String
  body      String
  actorId   String?             @map("actor_id")
  dedupeKey String              @unique @map("dedupe_key")
  createdAt DateTime            @default(now()) @map("created_at")
  readAt    DateTime?           @map("read_at")

  user  User              @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User?             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  offer Offer?            @relation(fields: [offerId], references: [id])
  rule  NotificationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([offerId])
  @@map("notifications")
}
