# Copia este archivo como ".env" y adapta los valores a tu entorno local.
# No incluyas nunca credenciales reales en este archivo (sí puede
# versionarse, a diferencia de ".env", que está en .gitignore).
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/nombre_base_datos"

# Autenticación local provisional (DEC-019). El administrador inicial se crea
# con "npm run auth:bootstrap-admin" y se vincula a la persona "Dennis
# Barragan" del seed. Usa marcadores propios, nunca una contraseña real: este
# archivo se versiona.
ADMIN_BOOTSTRAP_USERNAME="cambia-este-usuario"
ADMIN_BOOTSTRAP_PASSWORD="cambia-esta-contrasena-temporal"

# Nombre de la cookie de sesión. Opcional: si se omite, se usa "vapps_session".
SESSION_COOKIE_NAME="vapps_session"

# Ruta local donde se guardan los adjuntos de oferta (bloque 6). Fuera de
# "public/" y fuera de Git. Si se omite, se usa "./storage/offer-attachments".
ATTACHMENTS_STORAGE_PATH="./storage/offer-attachments"
